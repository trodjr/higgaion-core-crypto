[1.841932, "o", "rm -f src/*.o libpqcmigration.a pqc_migration_cli\r\n"]
[1.882195, "o", "cc -std=c11 -Wall -O2 -I include -c src/pqc_crypto.c -o src/pqc_crypto.o\r\n"]
